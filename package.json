{
  "name": "pharmacypos",
  "version": "1.0.0",
  "private": true,
  "description": "Pharmacy billing & inventory for Indian medical stores (GST, batch/expiry, Schedule H1)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "start": "npm run start --workspace server",
    "demo": "npm run build && npm run seed && npm start",
    "test": "npm run test --workspace server",
    "verify:api": "npm run smoke --workspace server",
    "verify:ui": "node e2e/ui-verify.mjs",
    "verify:all": "npm run verify:api && npm run verify:ui && node e2e/verify-new-features.mjs && node e2e/verify-hold-and-dues.mjs && node e2e/verify-import-and-golive.mjs && node e2e/verify-doctor-and-upload.mjs && node e2e/verify-invoice-scan.mjs",
    "verify:features": "node e2e/verify-new-features.mjs",
    "verify:hold-dues": "node e2e/verify-hold-and-dues.mjs",
    "verify:import": "node e2e/verify-import-and-golive.mjs",
    "verify:doctor": "node e2e/verify-doctor-and-upload.mjs",
    "verify:scan": "node e2e/verify-invoice-scan.mjs",
    "seed": "npm run seed --workspace server --",
    "seed:force": "npm run seed --workspace server -- --force",
    "backup": "npm run backup --workspace server --",
    "backup:list": "npm run backup --workspace server -- --list",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "desktop": "npm run build && electron .",
    "desktop:rebuild": "electron-rebuild -f -w better-sqlite3",
    "desktop:dir": "npm run build && electron-builder --dir",
    "desktop:linux": "npm run build && electron-builder --linux",
    "desktop:win": "npm run build && electron-builder --win",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "verify:desktop": "npm run build && xvfb-run -a node e2e/verify-desktop.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9",
    "playwright": "^1.49.1"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "desktop/main.js"
}
